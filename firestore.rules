rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidResponse(data) {
      return data.keys().hasAll(['createdAt'])
        && data.createdAt is string
        && data.createdAt.size() <= 60;
    }

    match /responses/{responseId} {
      // Las respuestas son estrictamente privadas: solo visibles en la consola de Firebase
      allow read: if false;
      allow create: if isValidId(responseId) && isValidResponse(request.resource.data);
      allow update, delete: if false;
    }
  }
}
